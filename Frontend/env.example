# Copy this file to ".env" and fill in real values. NEVER commit ".env".
PORT=3001
# Base URL of the running CivicConnect API (the backend in the repository root)
API_URL=http://localhost:3000
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
