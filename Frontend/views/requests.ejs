<%- include('partials/header') %>
<h1>Service requests</h1>
<form method="get" action="/requests" class="search">
  <label for="term" class="sr-only">Search</label>
  <input id="term" name="term" type="search" value="<%= term %>" placeholder="Search title, description or category">
  <button type="submit">Search</button>
  <% if (term) { %><a href="/requests">Clear</a><% } %>
</form>
<% if (requests.length === 0) { %>
  <p class="empty"><%= term ? 'No requests match your search.' : 'No requests yet.' %> <a href="/requests/new">Submit a request</a></p>
<% } else { %>
  <table>
    <thead><tr><th>ID</th><th>Title</th><th>Category</th><th>Status</th><th>Assigned to</th><th>Created</th></tr></thead>
    <tbody>
    <% requests.forEach(r => { %>
      <tr>
        <td>#<%= r.id %></td>
        <td><a href="/requests/<%= r.id %>"><%= r.title %></a></td>
        <td><%= r.category %></td>
        <td><span class="<%= badge(r.status) %>"><%= r.status %></span></td>
        <td><%= r.assignedTo ? 'User ' + r.assignedTo : '–' %></td>
        <td><%= fmtDate(r.createdAt) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('partials/footer') %>
